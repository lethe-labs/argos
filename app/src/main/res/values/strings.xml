    <string name="app_name" translatable="false">Argos</string>
    <string name="tagline">Find out whether your phone was touched while you were away.</string>

    <string name="admin_description">Logs unlock attempts. Cannot lock or erase your device.</string>
    <string name="admin_explanation">Argos only watches unlock attempts, so it can tell you if someone tried to get into your phone. It can never lock or erase your device.</string>
    <string name="admin_disable_warning">Turning this off stops Argos from logging unlock attempts. The change itself is recorded.</string>

